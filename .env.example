# Copy this file to .env and put your real key in .env (never commit .env)
MESH_API_KEY=rsk_your_key_here

# Models (all called through Mesh). Change these if a model is not available on your account.
WRITER_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=anthropic/claude-sonnet-4.5
IMAGE_MODEL=openai/gpt-image-1
